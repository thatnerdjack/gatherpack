<%# The column is part of the partial so turbo streams can add, replace and
    remove a whole grid cell. %>
<div class="col-12 col-sm-6 col-xl-4" id="<%= dom_id team %>">
  <div class="card team-card">
    <div class="card-header fs-5 text-break" style="background-color: <%= team.display_color %>;">
      <%= link_to team, style: "color: #{contrasting_color(team.display_color)}", data: { turbo_frame: "team_modal" } do %>
        <%= i team.identifier_icon %> <%= team.name %>
      <% end %>
    </div>

    <div class="card-body">
      <div class="badge-container mb-2">
        <span class="badge bg-secondary"><%= team.team_type.name %></span>
        <span class="badge bg-secondary" title="Members"><%= i "users" %> <%= team.descendant_people.count %></span>
        <span class="badge bg-secondary" title="Managers"><%= i "user-tie" %> <%= team.all_managers_and_admins.count %></span>
      </div>

      <% if team.description.present? %>
        <div class="team-card-description"><%= md team.description %></div>
      <% end %>
    </div>

    <div class="card-footer">
      <small class="fw-bold"><%= pluralize team.managers.count, team.team_type.manager_title %></small>
      <div class="d-flex flex-row align-items-center flex-wrap">
        <% team.managers.order(display_name: :asc).each do |person| %>
          <div class="pe-1 py-1">
            <%= link_to person, title: person.display_name, data: { turbo: false } do %>
              <%= image_tag get_avatar_url_64(person.avatar), class: "person-img team-avatar" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
