<%# The column is part of the partial so turbo streams can add, replace and
    remove a whole grid cell. %>
<div class="col-12 col-sm-6 col-xl-4" id="<%= dom_id team %>">
  <div class="card team-card">
    <div class="card-header team-card-header" style="background-color: <%= team.display_color %>; color: <%= contrasting_color(team.display_color) %>;">
      <%= link_to team, class: "team-card-title text-break", style: "color: inherit", data: { turbo_frame: "team_modal" } do %>
        <%= i team.identifier_icon %>
        <span><%= team.name %></span>
      <% end %>
    </div>

    <div class="card-body team-card-body">
      <div class="team-card-meta">
        <span class="badge team-card-type"><%= team.team_type.name %></span>
        <span class="team-card-stat"><%= i "users" %> <%= pluralize team.descendant_people.count, "member" %></span>
        <span class="team-card-stat"><%= i "user-tie" %> <%= pluralize team.all_managers_and_admins.count, team.team_type.manager_title %></span>
      </div>

      <% if team.description.present? %>
        <div class="team-card-description"><%= md team.description %></div>
      <% end %>
    </div>

    <%# Only rendered when there is something to show — an empty avatar strip
        left every manager-less card with a stray band of whitespace. %>
    <% if team.managers.any? %>
      <div class="card-footer team-card-footer">
        <div class="team-card-avatars">
          <% team.managers.order(display_name: :asc).each do |person| %>
            <%= link_to person, title: person.display_name, data: { turbo: false } do %>
              <%= image_tag get_avatar_url_64(person.avatar), class: "person-img team-avatar" %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
