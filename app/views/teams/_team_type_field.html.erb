<%# Team type picker. Existing types are pills; anyone allowed to create team
    types can name a new one inline and it is created with the team. %>
<% pending_name = f.object.new_team_type_name %>
<div class="mb-3" data-controller="tag-select">
  <%= f.label :team_type_id, "Team Type", class: "form-label" %>

  <%= f.hidden_field :team_type_id, value: (pending_name.present? ? nil : f.object.team_type_id), data: { tag_select_target: "idField" } %>
  <%= f.hidden_field :new_team_type_name, data: { tag_select_target: "nameField" } %>

  <div class="tag-select" data-tag-select-target="list">
    <% TeamType.order(name: :asc).each do |team_type| %>
      <button type="button" class="btn btn-sm tag-select-option" data-tag-select-target="option" data-action="tag-select#select" data-tag-select-id-param="<%= team_type.id %>"><%= team_type.name %></button>
    <% end %>
    <% if pending_name.present? %>
      <button type="button" class="btn btn-sm tag-select-option" data-tag-select-target="option" data-action="tag-select#select" data-tag-select-name-param="<%= pending_name %>"><%= pending_name %></button>
    <% end %>
  </div>

  <% if policy(TeamType).create? %>
    <div class="input-group input-group-sm mt-2 tag-select-new">
      <%# Deliberately unnamed — the controller copies the value into the hidden fields above. %>
      <input type="text" class="form-control" placeholder="Add a team type…" aria-label="New team type name" autocomplete="off" data-tag-select-target="input" data-action="keydown.enter->tag-select#add">
      <button type="button" class="btn btn-outline-secondary" data-action="tag-select#add"><%= i "plus" %> Add</button>
    </div>
  <% end %>

  <% if f.object.errors[:team_type].any? %>
    <div class="invalid-feedback d-block"><%= f.object.errors[:team_type].to_sentence %></div>
  <% end %>
</div>
