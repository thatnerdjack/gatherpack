<%= f.error_notification %>
<%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

<% may_add_team_types = policy(TeamType).create? %>

<div class="row">
  <div class="col-md-6">
    <%= f.input :name %>
    <%= f.input :parent_id, as: :searching_combobox, label: "Parent Team", scope: "managed_teams", include_blank: true %>
    <%= f.input :color, as: :fancy_color %>
  </div>
  <div class="col-md-6">
    <%# Picks an existing team type, or names a new one that is created with the
        team — but only for people allowed to create team types on their own. %>
    <%= f.input :team_type_id, as: :creatable_combobox, label: "Team Type",
          collection: TeamType.order(name: :asc),
          name_when_new: ("team[new_team_type_name]" if may_add_team_types),
          hint: ("Type a name that isn't listed to create it." if may_add_team_types),
          input_html: { placeholder: may_add_team_types ? "Search or add a team type…" : "Search team types…" } %>
    <%= f.input :join_permission, collection: Team.join_permissions.keys, label_method: :titleize, include_blank: false %>
  </div>
  <div class="col-md-12">
    <%= f.input :description, wrapper_html: { class: "code-editor" }, input_html: { rows: 6, data: { lang: "markdown" } } %>
  </div>
</div>
